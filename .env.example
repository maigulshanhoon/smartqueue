# ==============================================================================
# SmartQueue - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your actual local or production credentials.
# Do NOT commit .env or any file containing real passwords to version control.

# Server Port (Render sets this dynamically, defaults to 8080)
PORT=8080

# Admin Portal Credentials (defaults: admin / admin123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database URL for MySQL (adjust host, port, database name, and SSL params as needed)
# If omitted, SmartQueue safely defaults to an in-memory H2 database for zero-setup demo mode.
DB_URL=jdbc:mysql://localhost:3306/smartqueue?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Database user
DB_USERNAME=your_mysql_username

# Database password
DB_PASSWORD=your_mysql_password
